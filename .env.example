# systemd EnvironmentFile; secret file must be owned by root and readable only by root.
BM_DATA_DIR=/var/lib/marking-bm
BM_PUBLIC_URL=https://marking.internal
BM_COOKIE_SECURE=1
# Generate with python scripts/password_hash.py (scrypt hash only).
BM_ADMIN_PASSWORD_HASH=
# Generate with python -c "import secrets;print(secrets.token_urlsafe(48))"
BM_SIGNER_TOKEN=
BM_SIGNER_THUMBPRINT=
BM_TRUE_URL=https://markirovka.crpt.ru
BM_OMS_URL=https://suzgrid.crpt.ru
# Enable only after configuring actual organization, signer and verifying all data.
BM_ALLOW_EXTERNAL_WRITES=0
