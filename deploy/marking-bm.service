[Unit]
Description=Marking Brand Manager
After=network-online.target
Wants=network-online.target
[Service]
User=markingbm
Group=markingbm
WorkingDirectory=/opt/marking-bm
EnvironmentFile=/etc/marking-bm.env
ExecStart=/opt/marking-bm/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
StateDirectory=marking-bm
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marking-bm
[Install]
WantedBy=multi-user.target
